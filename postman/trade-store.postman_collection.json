                "{{tradeId}}",
                "audit"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const outcomes = pm.response.json().map(e => e.outcome);",
                  "pm.test(\"Accepted and rejected submissions are audited\", () => { pm.expect(outcomes).to.include(\"ACCEPTED\"); pm.expect(outcomes).to.include(\"REJECTED\"); });",
                  "pm.test(\"Rejection reason recorded\", () => pm.expect(pm.response.json().map(e => e.reason)).to.include(\"LOWER_VERSION\"));"
                ],
                "type": "text/javascript"
