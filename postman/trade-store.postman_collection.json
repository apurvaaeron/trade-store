    {
      "name": "3. Asynchronous ingestion via Kafka",
      "item": [
        {
          "name": "Queue trade on Kafka -> 202",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades/async",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades",
                "async"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tradeId\": \"{{asyncTradeId}}\",\n  \"version\": 1,\n  \"counterPartyId\": \"CP-KAFKA\",\n  \"bookId\": \"B1\",\n  \"maturityDate\": \"31/12/2099\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Status QUEUED\", () => pm.expect(pm.response.json().status).to.eql(\"QUEUED\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Poll until consumed -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades/{{asyncTradeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades",
                "{{asyncTradeId}}"
              ]
            },
            "description": "Retries for up to ~15 seconds while the Kafka consumer stores the trade."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "setTimeout(() => {}, 1000);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get(\"pollAttempts\") || 0) + 1;",
                  "pm.collectionVariables.set(\"pollAttempts\", attempts);",
                  "if (pm.response.code === 404 && attempts < 15) {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "  pm.test(\"Stored from Kafka\", () => pm.expect(pm.response.json().counterPartyId).to.eql(\"CP-KAFKA\"));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Audit, listing, expiry, metrics",
      "item": [
        {
          "name": "Audit trail (MongoDB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades/{{tradeId}}/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
