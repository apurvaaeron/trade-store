{
  "info": {
    "_postman_id": "f994f8ee-e44a-4145-90b3-dbe7d8d30cbe",
    "name": "Trade Store",
    "description": "End-to-end checks for the Trade Store API. Run the whole collection in order (Runner or Newman). The first request generates unique trade IDs, so it can be re-run without cleaning data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check (sets run IDs)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "Run first. Generates unique trade IDs so the collection can be re-run without cleaning the database."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Application is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));",
              "const run = Date.now().toString(36).toUpperCase();",
              "pm.collectionVariables.set(\"tradeId\", \"PM-\" + run);",
              "pm.collectionVariables.set(\"asyncTradeId\", \"PM-ASYNC-\" + run);",
              "pm.collectionVariables.set(\"pollAttempts\", 0);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1. Version rules",
      "item": [
        {
          "name": "New trade v1 -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tradeId\": \"{{tradeId}}\",\n  \"version\": 1,\n  \"counterPartyId\": \"CP-ORIGINAL\",\n  \"bookId\": \"B1\",\n  \"maturityDate\": \"31/12/2099\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test(\"Stored as version 1, not expired\", () => { pm.expect(t.version).to.eql(1); pm.expect(t.expired).to.eql(\"N\"); });",
                  "pm.test(\"createdDate defaulted to today (dd/MM/yyyy)\", () => pm.expect(t.createdDate).to.match(/^\\d{2}\\/\\d{2}\\/\\d{4}$/));",
                  "pm.test(\"Location header points to the trade\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.collectionVariables.get(\"tradeId\")));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Same version v1 replaces record -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tradeId\": \"{{tradeId}}\",\n  \"version\": 1,\n  \"counterPartyId\": \"CP-SAME\",\n  \"bookId\": \"B1\",\n  \"maturityDate\": \"31/12/2099\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Counterparty replaced\", () => pm.expect(pm.response.json().counterPartyId).to.eql(\"CP-SAME\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Higher version v2 replaces record -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tradeId\": \"{{tradeId}}\",\n  \"version\": 2,\n  \"counterPartyId\": \"CP-HIGHER\",\n  \"bookId\": \"B1\",\n  \"maturityDate\": \"31/12/2099\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Now version 2\", () => pm.expect(pm.response.json().version).to.eql(2));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Lower version v1 rejected -> 422 LOWER_VERSION",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tradeId\": \"{{tradeId}}\",\n  \"version\": 1,\n  \"counterPartyId\": \"CP-LOWER\",\n  \"bookId\": \"B1\",\n  \"maturityDate\": \"31/12/2099\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Reason is LOWER_VERSION\", () => pm.expect(pm.response.json().reason).to.eql(\"LOWER_VERSION\"));",
                  "pm.test(\"ProblemDetail names the trade\", () => pm.expect(pm.response.json().tradeId).to.eql(pm.collectionVariables.get(\"tradeId\")));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get trade -> still v2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades/{{tradeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trades",
                "{{tradeId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Version 2 kept, lower version did not overwrite\", () => { pm.expect(t.version).to.eql(2); pm.expect(t.counterPartyId).to.eql(\"CP-HIGHER\"); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
