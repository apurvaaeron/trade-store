{
  "name": "trade-store",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "installMaven": "true", "version": "none" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "postCreateCommand": "mvn -B -ntp -q dependency:go-offline",
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot", "jebbs.plantuml", "cucumberopen.cucumber-official"] }
  }
}
